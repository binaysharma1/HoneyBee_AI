# ----copy to .env and edit as needed----

DATABASE_URL=postgresql+psycopg://postgres:changeme@db:5432/Honeybee_ai
JWT_SECRET=replace_me_with_a_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# provider: groq | nvidia | local
HONEYBEE_PROVIDER=groq

# groq (free / fast)
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=put_your_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# local LM Studio
HONEYBEE_MODEL=phi-3.5-mini-instruct
HONEYBEE_MODEL_URL=http://127.0.0.1:1234/v1
HONEYBEE_API_KEY=lm-studio

# NVIDIA NIM
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=nvapi-...

# Embeddings for the vector store (default local)
HONEYBEE_EMBEDDING_MODEL=text-embedding-embeddinggemma-300m-qat
HONEYBEE_EMBEDDING_DIMS=768
HONEYBEE_EMBEDDING_BASE_URL=http://host.docker.internal:1234/v1

# If you want to use cloud embeddings instead, point this at any
# OpenAI-compatible embedding endpoint and keep the same model name
